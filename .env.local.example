# ============================================================
# MyLife OS - Environment Configuration Example
# ============================================================

# Supabase Public API URL (Found in Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Safe to expose on client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Service Role Key (NEVER EXPOSE IN FRONTEND CODE)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Default Application Timezone
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

